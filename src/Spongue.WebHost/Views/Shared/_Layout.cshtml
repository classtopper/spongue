@using System.Globalization

<!doctype html>
<html lang="@CultureInfo.CurrentUICulture.Name.ToLowerInvariant()">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Spongue</title>
    @RenderSection("additionalMeta", false)

    <link spongue-append-version="true" rel="stylesheet" href="~/libs.min.css" />
    <link spongue-append-version="true" rel="stylesheet" href="~/_content/Spongue.Module.Core/site.css" />
    <script spongue-append-version="true" src="~/lib/angular/angular.min.js"></script>
    <script spongue-append-version="true" src="~/lib/bootstrap4/js/jquery-3.3.1.min.js"></script>

    @RenderSection("head", required: false)
    <style>
        .logo_text {
            background: none;
        }

            .logo_text a {
                text-decoration: none;
            }

                .logo_text a:hover {
                    text-decoration: none;
                }
    </style>
</head>
<body>
    <div class="top-bar">
        <div class="container">
            <ul class="nav justify-content-end">
                <partial name="_SelectLanguagePartial" />
                <partial name="_LoginPartial" />
            </ul>
        </div>
    </div>
    <div class="main-header">
        <div class="container">
            <div class="row">
                <div class="col-12 col-md-6 col-lg-4 logo logo_text">
                    <a asp-area="Core" asp-controller="Home" asp-action="Index">
                        @*<img alt="Spongue" src="~/_content/Spongue.Module.Core/Logo_Spongue.jpg" />*@
                        <span style="font-size:40px; color:#FFBE33; font-family:Calibri; ">Spongue</span> @*<br />*@
                        @*<span style="color:darkblue; padding-left:80px;">Shopping Ocean..</span>*@
                    </a>
                </div>
                <div class="col-10 col-md-5 col-lg-7 search-box">
                    @await Component.InvokeAsync("SearchForm")
                </div>
                <div class="col-2 col-md-1 cart-btn">
                    @await Component.InvokeAsync("CartBadge")
                </div>
            </div>
        </div>
    </div>
    <div class="navbar navbar-expand-lg navbar-light bg-light btco-hover-menu main-nav">
        <div class="container">
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarMain" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                @await Component.InvokeAsync("CategoryMenu")
            </div>
        </div>
    </div>
    <partial name="_CookieConsentPartial" />
    @RenderSection("generalslide", false)
    <div class="container body-content clearfix">

        @RenderBody()
    </div>
    <div class="footer-content">
        <div class="container">
            <div class="row" style="padding-top:20px;">
                <div class="col-md-3">
                    <h4>@Localizer["Help"]</h4>
                    <vc:menu menu-id="1"></vc:menu>
                </div>
                <div class="col-md-3">
                    <h4>@Localizer["Categories"]</h4>
                    <vc:menu menu-id="2"></vc:menu>
                </div>
                <div class="col-md-6">
                    <h4>Payments</h4>
                    <p>Shopping Ocean.</p>
                    <p>Fullfil your shop desire</p>

                </div>
            </div>

            <div class="row">
                <div class="offset-md-6 col-md-6">
                    <a href="#">
                        <img src="~/themes/CozaStore/images/icons/icon-pay-01.png" alt="ICON-PAY">
                    </a>

                    <a href="#">
                        <img src="~/themes/CozaStore/images/icons/icon-pay-02.png" alt="ICON-PAY">
                    </a>

                    <a href="#" class="m-all-1">
                        <img src="~/themes/CozaStore/images/icons/icon-pay-03.png" alt="ICON-PAY">
                    </a>

                    <a href="#" class="m-all-1">
                        <img src="~/themes/CozaStore/images/icons/icon-pay-04.png" alt="ICON-PAY">
                    </a>

                    <a href="#" class="m-all-1">
                        <img src="~/themes/CozaStore/images/icons/icon-pay-05.png" alt="ICON-PAY">
                    </a>
                </div>
            </div>
            <hr />

            <p class="pull-left">&copy; @DateTime.Now.Year - Spongue</p>
            <p class="pull-right">Powered by <a href="#"><strong>Spongue</strong></a></p>
        </div>
    </div>
    <div id="shopModal" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
            </div>
        </div>
    </div>
    <div id="productOverview" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg">
            <div class="modal-content modal-padding">
            </div>
        </div>
    </div>
    <script>
            window.spongueGlobalSetting = {};
            window.spongueGlobalSetting.lang = '@CultureInfo.CurrentCulture.Name';
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.12.9/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q" crossorigin="anonymous"></script>
    <script spongue-append-version="true" src="~/lib/bootstrap4/js/bootstrap.js"></script>
    <script spongue-append-version="true" src="~/lib/multi-dropdown-menu/js/bootstrap-4-navbar.js"></script>
    <script spongue-append-version="true" src="~/lib/matchheight/jquery.matchHeight.js"></script>
    <script spongue-append-version="true" src="~/lib/toastr/build/toastr.min.js"></script>
    <script spongue-append-version="true" src="~/lib/bootstrap-star-rating/js/star-rating.js"></script>
    <script spongue-append-version="true" src="~/lib/signalr/dist/browser/signalr.js"></script>
    @if (CultureInfo.CurrentCulture.Name != Spongue.Infrastructure.GlobalConfiguration.DefaultCulture)
    {
<script spongue-append-version="true" src="~/lib/bootstrap-star-rating/js/locales/@(CultureInfo.CurrentCulture.Name).js"></script>}
    <script spongue-append-version="true" src="~/_content/Spongue.Module.Core/main.js"></script>
    <script spongue-append-version="true" src="~/_content/Spongue.Module.ShoppingCart/add-to-cart.js"></script>
    <script spongue-append-version="true" src="~/_content/Spongue.Module.ProductComparison/product-comparison.js"></script>
    <script spongue-append-version="true" src="~/_content/Spongue.Module.WishList/wishlist.js"></script>
    @RenderSection("scripts", required: false)

    <partial name="_AnalyticsScript" />
</body>
</html>
